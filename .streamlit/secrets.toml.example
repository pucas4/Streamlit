# Copy this file to .streamlit/secrets.toml (local dev) and fill in real values,
# or paste the same keys into the "Secrets" panel when you deploy on
# Streamlit Community Cloud. NEVER commit the real secrets.toml file.

# Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY = "sk-ant-..."

# Your publication's base URL, e.g. "https://example.substack.com"
SUBSTACK_PUBLICATION_URL = "https://example.substack.com"

# Your own logged-in Substack session cookies. Paste each cookie's copied line
# on its own line, e.g.:
# substack.sid=...;Domain=substack.com;Path=/;Expires=...;SameSite=None;Secure
# substack.lli=...;Domain=substack.com;Path=/;Expires=...;SameSite=None;Secure
# See README "Getting your session cookies" for how to export these.
SUBSTACK_COOKIES = '''
'''

# Optional: only needed for the experimental "Automatic fetch" chat mode.
# See README "Find your chat endpoint" -- leave blank to just use Paste in.
SUBSTACK_CHAT_ENDPOINT = ""

# Simple shared password so random visitors to your public Streamlit URL
# can't read your paid content/chat digest. Pick anything.
APP_ACCESS_PASSWORD = "change-me"
